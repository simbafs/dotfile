{
	"$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
	"palette": {
		"pink": "#F5C2E7",
		"lavender": "#B4BEFE",
		"black": "#000000",
		"blue": "#4B95E9",
		"green": "#59C9A5",
		"orange": "#F07623",
		"red": "#D81E5B",
		"white": "#E0DEF4",
		"yellow": "#F3AE35",
		"git-ahead": "p:green",
		"git-behind": "p:orange",
		"git-changed": "p:yellow",
		"git-conflict": "p:red"
	},
	"maps": {
		"host_name": {
			"simbafs-fw-arch": "localhost"
		}
	},
	"upgrade": {
		"source": "cdn",
		"interval": "168h",
		"auto": false,
		"notice": false
	},
	"final_space": true,
	"version": 4,
	"blocks": [
		{
			"type": "prompt",
			"alignment": "left",
			"segments": [
				{
					"type": "session",
					"foreground": "p:green",
					"style": "plain",
					"template": "<b>{{ .UserName }}@{{ .HostName }}</b>"
				},
				{
					"type": "text",
					"style": "plain",
					"foreground": "p:yellow",
					"template": ":"
				},
				{
					"type": "path",
					"foreground": "p:blue",
					"options": {
						"style": "powerlevel",
						"max_width": 30
					},
					"style": "plain",
					"template": "<b>{{ .Path }}</b>"
				},
				{
					"type": "text",
					"style": "plain",
					"foreground": "p:yellow",
					"template": "{{ if gt .Jobs 0 }}({{ .Jobs }}){{ end }}{{ if .Root }}#{{ else }}${{ end }}"
				}
			]
		},
		{
			"type": "rprompt",
			"alignment": "right",
			"segments": [
				{
					"type": "executiontime",
					"style": "plain",
					"foreground": "p:yello",
					"template": "\udb80\udd09 {{ .FormattedMs }} ",
					"options": {
						"threshold": 500,
						"style": "austin"
					}
				},
				{
					"type": "status",
					"options": {
						"always_enabled": true
					},
					"template": "{{ if gt .Code 0 }}\uf00d{{ .Code }}{{ end }} ",
					"foreground": "p:yellow",
					"style": "plain",
					"foreground_templates": ["{{ if gt .Code 0 }}p:red{{ end }}"]
				},
				{
					"type": "git",
					"style": "plain",
					"options": {
						"branch_template": "{{ trunc 25 .Branch }}",
						"fetch_status": true,
						"fetch_upstream_icon": true,
						"branch_icon": "\ue725 ",
						"cherry_pick_icon": "\ue29b ",
						"commit_icon": "\uf417 ",
						"merge_icon": "\ue727 ",
						"no_commits_icon": "\uf0c3 ",
						"rebase_icon": "\ue728 ",
						"revert_icon": "\uf0e2 ",
						"tag_icon": "\uf412 "
					},
					"template": "{{ if .UpstreamURL }}{{ url .UpstreamIcon .UpstreamURL }} {{ end }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}",
					"foreground": "p:yellow",
					"foreground_templates": [
						"{{ if or (.Working.Changed) (.Staging.Changed) }}p:git-changed{{ end }}",
						"{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:git-conflict{{ end }}",
						"{{ if gt .Ahead 0 }}p:git-ahead{{ end }}",
						"{{ if gt .Behind 0 }}p:git-behind{{ end }}"
					]
				}
			]
		}
	]
}
