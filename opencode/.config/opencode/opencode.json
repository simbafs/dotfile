{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-e79a60d9-cca1-446e-ad6c-7be1257fbe7d"
      },
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  },
  "permission": {
    "bash": {
      "git add": "ask",
      "git commit": "ask",
      "rm *": "ask"
    },
    "read": {
      "~/go": "allow"
    },
    "skill": {
      "*": "allow"
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://imslab:11434/v1"
      },
      "models": {
        "qwen3:8b": {
          "name": "Qwen3 8B - General"
        },
        "qwen2.5-coder:7b": {
          "name": "Qwen2.5 Coder 7B - Coding"
        },
        "qwen3.5-opencode": {
          "name": "Qwen3.5 4B - OpenCode 32K",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "qwen3.5-opencode-64k": {
          "name": "Qwen3.5 4B - OpenCode 64K",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
      }
    }
  }
}
